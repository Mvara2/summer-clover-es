  },
  {
    "en": "“Oh...”",
    "ko_bytes": 15
  },
  {
    "en": "“Hmph, I'll walk by myself then.”",
    "ko_bytes": 32
  },
  {
    "en": "Despite saying that, I still end up carrying Ayano to the living room and gently place her on the sofa.",
    "ko_bytes": 95
  },
  {
    "en": "Then I go to the kitchen to get the pudding and bring it in front of her.",
    "ko_bytes": 78
  },
  {
    "en": "“Feed me.”",
    "ko_bytes": 16
  },
  {
    "en": "“What's gotten into you lately?”",
    "ko_bytes": 24
  },
  {
    "en": "“What do you mean?”",
    "ko_bytes": 17
  },
  {
    "en": "“...You seem different?”",
    "ko_bytes": 34
  },
  {
    "en": "“Ah, um—how different?”",
    "ko_bytes": 42
  },
  {
    "en": "“You don't act... mature, like you used to.”",
