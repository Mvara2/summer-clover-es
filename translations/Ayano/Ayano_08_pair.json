[
  {
    "en": "Ever since that day, Ayano's attitude has changed.",
    "ko_bytes": 90
  },
  {
    "en": "She used to tease me and act all mischievous. Now she acts like a child who loves to be pampered.",
    "ko_bytes": 97
  },
  {
    "en": "“Hey—{Me}!”",
    "ko_bytes": 17
  },
  {
    "en": "“I want pudding!”",
    "ko_bytes": 31
  },
  {
    "en": "“Didn't you have some this morning?”",
    "ko_bytes": 29
  },
  {
    "en": "“I don't care, I want more—”",
    "ko_bytes": 24
  },
  {
    "en": "“Alright, alright, I'll get it from the fridge, just go sit in the living room.”",
    "ko_bytes": 82
  },
  {
    "en": "“Wait—”",
    "ko_bytes": 15
  },
  {
    "en": "“Yeah, what's wrong?”",
    "ko_bytes": 22
  },
  {
    "en": "“I can't move, carry me there.”",
