  },
  {
    "en": "BOSS",
    "ko_bytes": 4
  },
  {
    "en": "“{Me} is the best...”",
    "ko_bytes": 23
  },
  {
    "en": "“Here you go, Shizuko. This is for you.”",
    "ko_bytes": 32
  },
  {
    "en": "“Wow!!! Thanks so much!”",
    "ko_bytes": 40
  },
  {
    "en": "“.........”",
    "ko_bytes": 18
  },
  {
    "en": "“Will you help me get one too, {Me}?”",
    "ko_bytes": 55
  },
  {
    "en": "“Oof... That might be a bit tough. How about next time?”",
    "ko_bytes": 71
  },
  {
    "en": "“Okay~ Let's go book a room before it gets dark.”",
    "ko_bytes": 60
  },
  {
    "en": "“.........”",
    "ko_bytes": 18
  },
  {
    "en": "“Gaaar—!”",
